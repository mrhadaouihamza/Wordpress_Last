<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="<%= locals.metaDescription || 'Browse WordPress plugins and themes, manage purchases, and connect eligible plugin updates.' %>">
<title><%= locals.title ? locals.title + ' — ' : '' %><%= locals.siteName || 'Wordpresso' %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/store.css">
</head>
<body class="storefront">
<aside class="announcement-strip">
  <span class="announce-icon">✦</span>
  <span><%= locals.storeTagline || 'Premium WordPress tools for your next great website.' %></span>
  <a href="/plans">Explore plans <b>→</b></a>
</aside>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/"><%= locals.siteName || 'Wordpresso' %><span class="brand-tld">.store</span></a>
    <nav class="nav">
      <a href="/store">Store</a>
      <a href="/plans">Plans</a>
      <a href="/cart">Cart <% if (locals.cartCount && locals.cartCount > 0) { %><span class="count-pill"><%= locals.cartCount %></span><% } %></a>
      <% if (locals.customer) { %>
        <a href="/account">My account</a>
        <form method="post" action="/logout" class="inline-form" style="display:inline;">
          <button type="submit" class="btn btn-ghost" style="cursor:pointer; background:transparent; border:none; color:inherit; font:inherit;">Sign out</button>
        </form>
      <% } else { %>
        <a href="/login">Sign in</a>
        <a href="/register" class="btn btn-primary">Create account</a>
      <% } %>
    </nav>
  </div>
</header>
<main class="container">
