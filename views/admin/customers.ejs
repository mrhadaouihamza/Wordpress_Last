<%- include('../layouts/admin-header') %>

<div style="margin-bottom:2rem;">
  <h1 style="font-size:1.8rem; font-weight:800; margin:0 0 0.5rem;">Registered Customers</h1>
  <p class="muted" style="margin:0;">View customer accounts, active entitlements, and subscription states.</p>
</div>

<div style="background:#fff; border:1px solid var(--line); border-radius:14px; overflow:hidden; box-shadow:var(--shadow-sm);">
  <table style="width:100%; border-collapse:collapse; text-align:left; font-size:0.9rem;">
    <thead>
      <tr style="border-bottom:1px solid var(--line); background:var(--bg); color:var(--muted); font-size:0.75rem; text-transform:uppercase;">
        <th style="padding:1rem 1.25rem;">Customer</th>
        <th style="padding:1rem 1.25rem;">Email</th>
        <th style="padding:1rem 1.25rem;">Joined</th>
        <th style="padding:1rem 1.25rem;">Status</th>
        <th style="padding:1rem 1.25rem; text-align:right;">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% customers.forEach(function(c) { %>
        <tr style="border-bottom:1px solid var(--line);">
          <td style="padding:1rem 1.25rem; font-weight:700;"><%= c.name || 'Unnamed Customer' %></td>
          <td style="padding:1rem 1.25rem; font-family:monospace;"><%= c.email %></td>
          <td style="padding:1rem 1.25rem; color:var(--muted);"><%= new Date(c.created_at).toLocaleDateString() %></td>
          <td style="padding:1rem 1.25rem;">
            <span style="background:<%= c.status === 'active' ? 'var(--ok-soft)' : 'var(--bad-soft)' %>; color:<%= c.status === 'active' ? 'var(--ok)' : 'var(--bad)' %>; font-size:0.75rem; font-weight:700; padding:0.25rem 0.6rem; border-radius:4px; text-transform:uppercase;">
              <%= c.status %>
            </span>
          </td>
          <td style="padding:1rem 1.25rem; text-align:right;">
            <form method="post" action="/admin/customers/<%= c.id %>/suspend" style="display:inline;">
              <button type="submit" class="btn btn-ghost" style="padding:0.3rem 0.6rem; font-size:0.8rem; border:1px solid var(--line); border-radius:6px; cursor:pointer;">
                <%= c.status === 'active' ? 'Suspend' : 'Activate' %>
              </button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<%- include('../layouts/admin-footer') %>
