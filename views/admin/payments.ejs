<%- include('../layouts/admin-header') %>

<div style="margin-bottom:2rem; max-width:700px;">
  <h1 style="font-size:1.8rem; font-weight:800; margin:0 0 0.5rem;">Payment Gateway (USDT on BSC)</h1>
  <p class="muted" style="margin:0;">Manage BNB Smart Chain receiving address, BEP-20 USDT contract address, and RPC endpoint.</p>
</div>

<div style="background:#fff; border:1px solid var(--line); border-radius:14px; padding:2rem; max-width:700px; box-shadow:var(--shadow-sm);">
  <form method="post" action="/admin/payments">
    <div style="margin-bottom:1.25rem;">
      <label style="display:block; font-weight:600; font-size:0.9rem; margin-bottom:0.4rem;">Receiving Wallet Address (BSC)</label>
      <input type="text" name="bsc_wallet" value="<%= settings.bsc_wallet %>" required style="width:100%; padding:0.75rem 1rem; border:1px solid var(--line); border-radius:8px; font-family:monospace; font-size:0.95rem;">
    </div>

    <div style="margin-bottom:1.25rem;">
      <label style="display:block; font-weight:600; font-size:0.9rem; margin-bottom:0.4rem;">USDT Token Contract Address</label>
      <input type="text" name="usdt_contract" value="<%= settings.usdt_contract %>" required style="width:100%; padding:0.75rem 1rem; border:1px solid var(--line); border-radius:8px; font-family:monospace; font-size:0.95rem;">
    </div>

    <div style="margin-bottom:1.5rem;">
      <label style="display:block; font-weight:600; font-size:0.9rem; margin-bottom:0.4rem;">BNB Smart Chain HTTPS RPC Endpoint</label>
      <input type="url" name="bsc_rpc" value="<%= settings.bsc_rpc %>" required style="width:100%; padding:0.75rem 1rem; border:1px solid var(--line); border-radius:8px; font-family:monospace; font-size:0.95rem;">
    </div>

    <button type="submit" class="btn btn-primary btn-lg" style="cursor:pointer;">
      Update Payment Gateway Configuration
    </button>
  </form>
</div>

<%- include('../layouts/admin-footer') %>
